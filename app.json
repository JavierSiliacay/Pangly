{
  "expo": {
    "name": "Pangly",
    "slug": "Pangly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060D0A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#060D0A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.javiersiliacay.Pangly"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#10B981",
          "sounds": [
            "./assets/sounds/notification_sound.wav"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ffc8a461-5886-4eee-9ddc-9a63cd228714"
      }
    }
  }
}
